APP_DOMAIN={{ .AppDomain }}
APP_URL={{ .AppUrl }}
OIDC_CLIENT_ID={{ .OIDCClientID }}
OIDC_CLIENT_SECRET={{ .OIDCClientSecret }}
OIDC_AUTH_BASE_URL={{ .AuthUrl }}
AUTH_LOCAL_SOCKET={{ .AuthSocket }}
OIDC_REDIRECT_URI={{ .OIDCRedirectURI }}
SESSION_SECRET={{ .Secret }}
SOCKET={{ .DataDir }}/backend.sock
KEY_FILE={{ .DataDir }}/server/id_ed25519.pub
ID_SOCKET={{ .DataDir }}/hbbs.sock
RELAY_SOCKET={{ .DataDir }}/hbbr.sock
ACCOUNT_DIR={{ .DataDir }}/account
